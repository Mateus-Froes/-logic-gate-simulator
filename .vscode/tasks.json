{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys2/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}/include",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}.exe",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila o arquivo ativo (GUI ou Terminal) pelo botão Play do VS Code"
        },
        {
            "type": "cppbuild",
            "label": "Build GUI (SFML 3)",
            "command": "C:/msys2/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-Wall",
                "-Wextra",
                "-DMULTI_FILE_BUILD",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/Component.cpp",
                "${workspaceFolder}/src/Wire.cpp",
                "${workspaceFolder}/src/Gates.cpp",
                "${workspaceFolder}/src/CircuitBoard.cpp",
                "${workspaceFolder}/src/gui/GuiRenderer.cpp",
                "${workspaceFolder}/src/gui/Sidebar.cpp",
                "${workspaceFolder}/src/gui/GuiApplication.cpp",
                "${workspaceFolder}/src/gui/main_gui.cpp",
                "-o",
                "${workspaceFolder}/build/simulador_gui.exe",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "Build Core (Terminal)",
            "command": "C:/msys2/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-Wall",
                "-Wextra",
                "-DMULTI_FILE_BUILD",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/Component.cpp",
                "${workspaceFolder}/src/Wire.cpp",
                "${workspaceFolder}/src/Gates.cpp",
                "${workspaceFolder}/src/CircuitBoard.cpp",
                "${workspaceFolder}/src/main.cpp",
                "-o",
                "${workspaceFolder}/build/simulador.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}
